<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="accueil.css">
    <link rel="stylesheet" href="/bootstrap/css/bootstrap.min.css">
    <link rel="stylesheet" href="font/css/all.min.css">
</head>
<body data-user-id="<%= user ? user.id : '' %>">
    <nav class="navbar">
        <h1>Bienvenu <%= user.pseudo %></h1>
        <a href="" class="btnLogout">
            <% if(user.photo == null) { %>
                <div class="avatar">
                    <i class="fa fa-user"></i>
                </div>
            <% } else { %>
                <img src="/<%= user.photo %>" class="avatar" alt="OK">
            <% } %> <span style="margin-left: 1rem;">Deconnexion</span>
        </a>
    </nav>

        <!-- Modal -->
        <div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h1 class="modal-title fs-5" id="exampleModalLabel">Modal title</h1>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/publier" method="post" enctype="multipart/form-data">
                            <textarea class="form-control" name="message" placeholder="Text message"></textarea>
                            <input type="file" class="form-control mt-3" name="image_pub" accept="image/*">
                            <button class="btn btn-primary btn_publier mt-3">Publier</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    <div class="contenu">
        <div class="contenu-entete">
            <a href="/accueil"><i class="fa fa-home"></i></a>
                <a href="/utilisateurs"><i class="fa fa-users"></i></a>
                <div class="dropdown">
                    <div class="notif-container">
                        <i class="fa fa-bell"></i>
                        <span id="notif-count">0</span>
                    </div>
                    <div class="dropdown-content">
                        <div class="notif-detail">
                            <% if(notifications.length === 0) { %>
                                <p>Aucune notification</p>
                            <% } else { %>
                                <% notifications.forEach(notific => { %>
                                    <div class="tous-detail">
                                        <div class="notif-affichage">
                                            <% if(notific.photo == null) { %>
                                                <div class="avatar" style="width: 120px;">
                                                    <i class="fa fa-user"></i>
                                                </div>
                                            <% } else { %>
                                                <img src="/<%= notific.photo %>" class="avatar" width="200px" height="200px" alt="OK">
                                            <% } %>
                                            <%= notific.contenu_notif %>
                                        </div>
                                        <small class="notif-date" data-date="<%= notific.date_envoi %>">
                                                <%= dayjs(notific.date_envoi).fromNow() %>
                                        </small>
                                        <div class="lesbtn">
                                            <button type="button" class="btn btn-primary">Accepter</button>
                                            <button type="button" class="btn btn-danger">Refuser</button>
                                        </div>
                                    </div>
                                <% }) %>
                            <% } %>
                        </div>
                    </div>
                </div>
                <a href="/message"><i class="fab fa-facebook-messenger"></i></a>
            </div>
            <div class="contenu-body">
                <div class="contenu-body d-flex justify-content-center">
                    <button type="button" class="btn btn-primary btn_publication mt-3 mb-4" data-bs-toggle="modal" data-bs-target="#exampleModal">
                        Publication
                    </button>
                </div>
                <% if(publications.length === 0) { %>
                    <p>Aucune publication</p>
                <% } else { %>
                    <% publications.forEach(p => { %>
                    <div class="card publication">
                        <div class="contenu-header">
                            <% if(p.photo_user == null) { %>
                                <div class="avatar">
                                    <i class="fa fa-user"></i>
                                </div>
                            <% } else { %>
                                <img src="/<%= p.photo_user %>" class="avatar" alt="OK">
                            <% } %>
                            <h2><%= p.user %></h2>
                        </div>
                        <% if(p.image_pub == null) { %>
                            <div class="article"><%= p.contenu_pub %></div>
                        <% } else { %>
                            <div class="article"><%= p.contenu_pub %></div>
                            <div class="article bg-secondary">
                                <div class="col-md-4"> 
                                    <div class="ratio ratio-21x9 article-img bg-light border">
                                        <img src="/<%= p.image_pub %>" class="img-centered" alt="Cover">
                                    </div>
                                </div>
                            </div>
                        <% } %>
                        <div class="footer-pub">
                            <i class="fa fa-thumbs-o-up"></i>
                            <i class="fa fa-message"></i>
                        </div>
                    </div>
                    <% }) %>
                <% } %>
            </div>
        </div>
    </div>
        
    <script src="/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="/socket.io/socket.io.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/dayjs.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/plugin/relativeTime.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dayjs@1/locale/fr.js"></script>
    <script>
        const socket = io();
        const USER_ID = document.body.dataset.userId;

        if(USER_ID) {
            socket.emit('join', USER_ID);
        }

        function loadNotifCount() {
            fetch('/notifications/count')
            .then(res => res.json())
            .then(data => {
                document.getElementById('notif-count').innerText = data.count;
            });
        }

        // au chargement
        loadNotifCount();

        // temps réel
        socket.on('new-notification', () => {
            loadNotifCount();
        });

        function addFriend(userId) {
            fetch(`/notification/${userId}`, {
                method: 'POST'
            })
            .then(res => res.json())
            .then(data => {
                console.log('Invitation envoyée');
            })
            .catch(err => console.error(err));
        };

        // Configuration côté client
        dayjs.extend(dayjs_plugin_relativeTime);
        dayjs.locale('fr');

        // On met à jour toutes les minutes
        setInterval(() => {
            document.querySelectorAll('.notif-date').forEach(el => {
                const originalDate = el.getAttribute('data-date');
                el.innerText = dayjs(originalDate).fromNow();
            });
        }, 60000); // 60000 ms = 1 minute

        const modal = document.getElementById("modalpublier");
        const btn = document.getElementById("btnpublier");

        btn.addEventListener("click", function (e) {
            e.preventDefault();
            modal.classList.add("show");
        });

        // clic en dehors → fermer
        modal.addEventListener("click", function (e) {
            if (e.target === modal) {
                modal.classList.remove("show");
            }
        });
    </script>
</body>
</html>

